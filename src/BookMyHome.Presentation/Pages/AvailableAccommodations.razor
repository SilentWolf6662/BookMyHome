@page "/available-accommodations"
@using BookMyHome.Facade.DTO;
@using BookMyHome.Presentation.Services.Accommodation;

<PageTitle>Available Accommodations</PageTitle>

<h1>Available Accommodations</h1>

@foreach (var accommodation in Accommodations)
{
	<article>
		@accommodation.BuildingType
		@accommodation.Location
		@accommodation.Facility
		@accommodation.Price
		@accommodation.HouseRule
	</article>
}
@code {
	private List<AccommodationItem> Accommodations = new List<AccommodationItem>();

	[Inject]
	public IAccommodationService AccommodationService { get; set; }
	private int ErrorCode { get; set; } = 0;

	protected override async Task OnInitializedAsync()
	{
		Accommodations = (await AccommodationService.GetAllItems())?.ToList() ?? new List<AccommodationItem>();
		//Hvis ingen varer findes, returneres en tom liste
	}
}
